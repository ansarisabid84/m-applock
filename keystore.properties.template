# Copy to `keystore.properties` (same directory) and fill in. Never commit the copy.
#
# Create the key first — this is the ONE file you cannot lose or regenerate. If it is gone,
# you can no longer update the app under the same listing:
#
#   keytool -genkeypair -v \
#     -keystore upload-keystore.jks \
#     -alias applock-upload \
#     -keyalg RSA -keysize 4096 -validity 10000 \
#     -dname "CN=Sabid Ansari, O=AppLock, C=IN"
#
# Back up `upload-keystore.jks` and these passwords somewhere off this machine.

storeFile=upload-keystore.jks
storePassword=CHANGE_ME
keyAlias=applock-upload
keyPassword=CHANGE_ME
